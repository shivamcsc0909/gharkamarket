# ==============================================================================
# OFFICEFUEL / GHAR KA MARKET — BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
APP_NAME="OfficeFuel"
APP_ENV="production"
APP_DEBUG=false
APP_URL="https://officefuel.in"
API_URL="https://api.officefuel.in"
FRONTEND_URL="https://www.officefuel.in"
ADMIN_URL="https://admin.officefuel.in"
APP_KEY="replace_with_a_secure_random_64_character_string"
JWT_SECRET="replace_with_a_secure_random_jwt_secret"

# Database Configuration (Hostinger MySQL)
DB_CONNECTION="mysql"
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_DATABASE="u123456789_officefuel"
DB_USERNAME="u123456789_dbuser"
DB_PASSWORD="your_strong_mysql_password"

# Razorpay Payment Gateway (Test or Live)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Google OAuth Sign-In
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://www.officefuel.in/auth/google/callback"

# Email / SMTP Configuration (Hostinger Titan Mail or Custom SMTP)
MAIL_MAILER="smtp"
MAIL_HOST="smtp.hostinger.com"
MAIL_PORT=587
MAIL_USERNAME="orders@officefuel.in"
MAIL_PASSWORD="your_smtp_password"
MAIL_ENCRYPTION="tls"
MAIL_FROM_ADDRESS="orders@officefuel.in"
MAIL_FROM_NAME="OfficeFuel"

# SMS Gateway (Optional: msg91 | twilio | none)
SMS_PROVIDER="none"
SMS_AUTH_KEY=""
SMS_SENDER_ID="OFFCFL"
SMS_TEMPLATE_ID=""

# Third-Party Delivery Provider (Optional: shiprocket | delhivery | internal)
DELIVERY_PROVIDER="shiprocket"
DELIVERY_API_EMAIL=""
DELIVERY_API_PASSWORD=""
DELIVERY_API_TOKEN=""

# Central Business Config Overrides (Optional)
BUSINESS_BRAND_NAME="OfficeFuel"
BUSINESS_PARENT_COMPANY="Ghar Ka Market"
BUSINESS_EMAIL="support@officefuel.in"
BUSINESS_PHONE="+91 98765 43210"
BUSINESS_WHATSAPP="+91 98765 43210"
BUSINESS_ADDRESS="DLF Cyber City, Phase 2, Gurugram, Delhi NCR - 122002"
DEFAULT_SHIPPING_FEE=49.00
FREE_SHIPPING_THRESHOLD=499.00
TAX_PERCENTAGE=5.0
